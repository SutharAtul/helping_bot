# ==============================================================================
# OTA RAG Bot Backend Environment Configuration
# ==============================================================================

# Application Configuration
FLASK_ENV=development
FLASK_DEBUG=True
APP_NAME=ota-rag-bot
HOST=0.0.0.0
PORT=5000
