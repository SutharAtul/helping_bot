# ==============================================================================
# OTA RAG Bot Backend Environment Configuration (.env.example)
# Note: Placeholders only. Copy this file to .env for local development.
# Never commit actual credentials or production secrets to source control.
# ==============================================================================

# Application Environment (options: development, testing, production)
APP_ENV=development

# Secret key used for cryptographic signing and session security
# In production, replace with a 32+ character random secret string
SECRET_KEY=your-development-secret-key-placeholder

# MongoDB Connection Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ota_rag_db

# Logging Configuration (options: DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Server & Network Configuration
PORT=5000
MAX_CONTENT_LENGTH=16777216
